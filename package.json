{
  "name": "@simeonradivoev/gameflow-itch",
  "displayName": "itch.io",
  "version": "0.2.0",
  "description": "Discover, download, install, and play itch.io games in Gameflow.",
  "repository": {
    "type": "git",
    "url": "https://github.com/simeonradivoev/gameflow-itch"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "category": "sources",
  "icon": "https://static.itch.io/images/itchio-textless-white.svg",
  "keywords": [
    "gameflow-plugin",
    "gameflow",
    "itch.io",
    "html5",
    "webgl",
    "web-games",
    "butler",
    "game-downloads"
  ],
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "peerDependencies": {
    "@simeonradivoev/gameflow-sdk": "^1.10.0",
    "typescript": "^5"
  },
  "scripts": {
    "build": "bunx gameflow-build",
    "test": "bun test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prepublishOnly": "bun run test && bun run build",
    "release": "bun publish --access public"
  },
  "dependencies": {
    "@itchio/butlerd": "^15.0.0",
    "cheerio": "^1.2.0",
    "node-stream-zip": "^1.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
